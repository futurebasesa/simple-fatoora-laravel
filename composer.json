{
    "name": "simplefatoora/laravel",
    "description": "Official Laravel package for the Simple Fatoora API",
    "type": "library",
    "keywords": [
        "laravel",
        "simple fatoora",
        "saudi arabia",
        "zatca",
        "e-invoicing"
    ],
    "homepage": "https://simplefatoora.com/en/integration",
    "support": {
        "docs": "https://simplefatoora.com/en/integration",
        "issues": "https://github.com/futurebasesa/simple-fatoora-laravel/issues",
        "security": "https://github.com/futurebasesa/simple-fatoora-laravel/security/policy"
    },
    "authors": [
        {
            "name": "Future Base",
            "homepage": "https://futurebase.sa"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SimpleFatoora\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimpleFatoora\\Laravel\\Tests\\": "tests/",
            "SimpleFatoora\\Laravel\\Tools\\": "tools/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleFatoora\\Laravel\\SimpleFatooraServiceProvider"
            ],
            "aliases": {
                "SimpleFatoora": "SimpleFatoora\\Laravel\\Facades\\SimpleFatoora"
            }
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "contract": "phpunit --testsuite contract",
        "contract:compare": "php tools/compare-openapi.php resources/openapi.json resources/openapi.json",
        "format": "pint",
        "format:check": "pint --test",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
